# Portaly is currently configured with frontend-safe Firebase web config in firebase-config.js.
# If you later migrate to a Vite-based setup, use VITE_ prefixes for client-visible values.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
VITE_FIREBASE_FUNCTIONS_BASE_URL=
VITE_WORKER_APP_URL=
