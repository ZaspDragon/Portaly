rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function userPath() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }

    function userExists() {
      return signedIn() && exists(userPath());
    }

    function currentUser() {
      return get(userPath()).data;
    }

    function role() {
      return userExists() ? currentUser().role : null;
    }

    function agencyId() {
      return userExists() ? currentUser().agencyId : null;
    }

    function isPlatformOwner() {
      return role() == "platformOwner";
    }

    function isAgencyOwner() {
      return role() == "agencyOwner";
    }

    function isAgencyAdmin() {
      return role() == "agencyAdmin";
    }

    function isAgencyStaff() {
      return isAgencyOwner() || isAgencyAdmin();
    }

    function sameAgencyCreate() {
      return request.resource.data.agencyId == agencyId();
    }

    function sameAgencyRecord() {
      return resource.data.agencyId == agencyId();
    }

    match /users/{userId} {
      allow read: if signedIn() && (
        isPlatformOwner() ||
        request.auth.uid == userId ||
        resource.data.agencyId == agencyId()
      );

      allow create: if signedIn() && request.auth.uid == userId;

      allow update: if signedIn() && (
        isPlatformOwner() ||
        request.auth.uid == userId ||
        (isAgencyOwner() && resource.data.agencyId == agencyId())
      );

      allow delete: if isPlatformOwner();
    }

    match /agencies/{agencyDocId} {
      allow read: if signedIn() && (
        isPlatformOwner() ||
        agencyDocId == agencyId() ||
        resource.data.ownerUserId == request.auth.uid
      );

      allow create: if signedIn();

      allow update: if signedIn() && (
        isPlatformOwner() ||
        (isAgencyStaff() && agencyDocId == agencyId())
      );

      allow delete: if isPlatformOwner();
    }

    match /clients/{clientId} {
      allow read: if signedIn() && (
        isPlatformOwner() ||
        sameAgencyRecord()
      );

      allow create: if signedIn() && (
        isPlatformOwner() ||
        (isAgencyStaff() && sameAgencyCreate())
      );

      allow update, delete: if signedIn() && (
        isPlatformOwner() ||
        (isAgencyStaff() && sameAgencyRecord())
      );
    }

    match /sites/{siteId} {
      allow read: if signedIn() && (
        isPlatformOwner() ||
        sameAgencyRecord()
      );

      allow create: if signedIn() && (
        isPlatformOwner() ||
        (isAgencyStaff() && sameAgencyCreate())
      );

      allow update, delete: if signedIn() && (
        isPlatformOwner() ||
        (isAgencyStaff() && sameAgencyRecord())
      );
    }

    match /workers/{workerId} {
      allow read: if signedIn() && (
        isPlatformOwner() ||
        sameAgencyRecord()
      );

      allow create: if signedIn() && (
        isPlatformOwner() ||
        (isAgencyStaff() && sameAgencyCreate())
      );

      allow update, delete: if signedIn() && (
        isPlatformOwner() ||
        (isAgencyStaff() && sameAgencyRecord())
      );
    }

    match /assignments/{assignmentId} {
      allow read: if signedIn() && (
        isPlatformOwner() ||
        sameAgencyRecord()
      );

      allow create: if signedIn() && (
        isPlatformOwner() ||
        (isAgencyStaff() && sameAgencyCreate())
      );

      allow update, delete: if signedIn() && (
        isPlatformOwner() ||
        (isAgencyStaff() && sameAgencyRecord())
      );
    }

    match /punches/{punchId} {
      allow read: if signedIn() && (
        isPlatformOwner() ||
        sameAgencyRecord()
      );

      // Public no-login worker punch
      allow create: if request.resource.data.agencyId is string
        && request.resource.data.siteId is string
        && request.resource.data.workerName is string
        && request.resource.data.action in ["clockIn", "startLunch", "endLunch", "clockOut"]
        && request.resource.data.source == "publicPunchPage";

      allow update, delete: if signedIn() && (
        isPlatformOwner() ||
        (isAgencyStaff() && sameAgencyRecord())
      );
    }

    match /punchRequests/{requestId} {
      allow read: if signedIn() && (
        isPlatformOwner() ||
        sameAgencyRecord()
      );

      // Public no-login missed punch request
      allow create: if request.resource.data.agencyId is string
        && request.resource.data.siteId is string
        && request.resource.data.workerName is string
        && request.resource.data.status == "pending"
        && request.resource.data.source == "publicPunchPage";

      allow update, delete: if signedIn() && (
        isPlatformOwner() ||
        (isAgencyStaff() && sameAgencyRecord())
      );
    }

    match /timesheets/{timesheetId} {
      allow read, create, update, delete: if signedIn() && (
        isPlatformOwner() ||
        (isAgencyStaff() && (sameAgencyRecord() || sameAgencyCreate()))
      );
    }

    match /approvals/{approvalId} {
      allow read, create, update, delete: if signedIn() && (
        isPlatformOwner() ||
        (isAgencyStaff() && (sameAgencyRecord() || sameAgencyCreate()))
      );
    }

    match /payrollRuns/{payrollRunId} {
      allow read, create, update, delete: if signedIn() && (
        isPlatformOwner() ||
        (isAgencyStaff() && (sameAgencyRecord() || sameAgencyCreate()))
      );
    }

    match /sitePunchDirectories/{siteId} {
      allow read: if true;

      allow create: if signedIn() && (
        isPlatformOwner() ||
        (isAgencyStaff() && sameAgencyCreate())
      );

      allow update, delete: if signedIn() && (
        isPlatformOwner() ||
        (isAgencyStaff() && sameAgencyRecord())
      );
    }

    match /settings/{settingsId} {
      allow read, create, update, delete: if signedIn() && (
        isPlatformOwner() ||
        (isAgencyStaff() && (sameAgencyRecord() || sameAgencyCreate()))
      );
    }

    match /subscriptions/{subscriptionId} {
      allow read, create, update: if signedIn() && (
        isPlatformOwner() ||
        (isAgencyOwner() && (sameAgencyRecord() || sameAgencyCreate()))
      );

      allow delete: if isPlatformOwner();
    }

    match /auditLogs/{auditId} {
      allow read: if signedIn() && (
        isPlatformOwner() ||
        sameAgencyRecord()
      );

      allow create: if signedIn();

      allow update, delete: if false;
    }

    match /clientInvites/{inviteId} {
      allow read, create, update, delete: if signedIn() && (
        isPlatformOwner() ||
        (isAgencyStaff() && (sameAgencyRecord() || sameAgencyCreate()))
      );
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
